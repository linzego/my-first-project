@@ -36,7 +36,9 @@ void CTheme::LoadDefaults()
 	m_ListBoxOddRowsBG = RGB(255, 255, 255);
 	m_ListBoxEvenRowsBG = RGB(243, 243, 243);
 	m_ListBoxOddRowsText = RGB(0, 0, 0);
 	m_ListBoxEvenRowsText = RGB(0, 0, 0);
+	m_ListBoxHoverBG = RGB(226, 236, 248);
+	m_ListBoxHoverText = RGB(20, 40, 65);
 	m_ListBoxSelectedBG = RGB(204, 204, 204);
 	m_ListBoxSelectedNoFocusBG = RGB(204, 204, 204);
 	m_ListBoxSelectedText = RGB(0, 0, 0);
@@ -151,9 +153,40 @@ bool CTheme::Load(CString csTheme, bool bHeaderOnly, bool bCheckLastWriteTime)
 	LoadColor(ItemHeader, "ListBoxOddRowsBG", m_ListBoxOddRowsBG);
 	LoadColor(ItemHeader, "ListBoxEvenRowsBG", m_ListBoxEvenRowsBG);
 	LoadColor(ItemHeader, "ListBoxOddRowsText", m_ListBoxOddRowsText);
 	LoadColor(ItemHeader, "ListBoxEvenRowsText", m_ListBoxEvenRowsText);
 	LoadColor(ItemHeader, "ListBoxSelectedBG", m_ListBoxSelectedBG);
 	LoadColor(ItemHeader, "ListBoxSelectedNoFocusBG", m_ListBoxSelectedNoFocusBG);
 	LoadColor(ItemHeader, "ListBoxSelectedText", m_ListBoxSelectedText);
 	LoadColor(ItemHeader, "ListBoxSelectedNoFocusText", m_ListBoxSelectedNoFocusText);
+
+	// Hover colors are optional so themes created before this feature remain valid.
+	// Derive readable defaults from the theme when explicit XML values are absent.
+	if (ItemHeader->FirstChildElement("ListBoxHoverBG") != NULL)
+	{
+		LoadColor(ItemHeader, "ListBoxHoverBG", m_ListBoxHoverBG);
+	}
+	else
+	{
+		COLORREF rowAverage = RGB(
+			(GetRValue(m_ListBoxOddRowsBG) + GetRValue(m_ListBoxEvenRowsBG)) / 2,
+			(GetGValue(m_ListBoxOddRowsBG) + GetGValue(m_ListBoxEvenRowsBG)) / 2,
+			(GetBValue(m_ListBoxOddRowsBG) + GetBValue(m_ListBoxEvenRowsBG)) / 2);
+		const int selectionMix = 35;
+		m_ListBoxHoverBG = RGB(
+			(GetRValue(rowAverage) * (100 - selectionMix) + GetRValue(m_ListBoxSelectedBG) * selectionMix) / 100,
+			(GetGValue(rowAverage) * (100 - selectionMix) + GetGValue(m_ListBoxSelectedBG) * selectionMix) / 100,
+			(GetBValue(rowAverage) * (100 - selectionMix) + GetBValue(m_ListBoxSelectedBG) * selectionMix) / 100);
+	}
+
+	if (ItemHeader->FirstChildElement("ListBoxHoverText") != NULL)
+	{
+		LoadColor(ItemHeader, "ListBoxHoverText", m_ListBoxHoverText);
+	}
+	else
+	{
+		const double luminance = 0.2126 * GetRValue(m_ListBoxHoverBG) +
+			0.7152 * GetGValue(m_ListBoxHoverBG) + 0.0722 * GetBValue(m_ListBoxHoverBG);
+		m_ListBoxHoverText = luminance >= 145.0 ? RGB(24, 32, 44) : RGB(245, 245, 245);
+	}
+
 	LoadColor(ItemHeader, "ClipPastedColor", m_clipPastedColor);
