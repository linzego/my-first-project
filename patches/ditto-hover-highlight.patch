+
+void CQListCtrl::SetHoverItem(int item)
+{
+\tif (item < 0 || item >= GetItemCount())
+\t\titem = -1;
+
+\tif (item == m_hoverItem)
+\t\treturn;
+
+\tint oldItem = m_hoverItem;
+\tm_hoverItem = item;
+
+\tif (oldItem >= 0 && oldItem < GetItemCount())
+\t\tRedrawItems(oldItem, oldItem);
+\tif (m_hoverItem >= 0 && m_hoverItem < GetItemCount())
+\t\tRedrawItems(m_hoverItem, m_hoverItem);
+}
+
+void CQListCtrl::UpdateHoverItemFromCursor()
+{
+\tCPoint point;
+\t::GetCursorPos(&point);
+\tScreenToClient(&point);
+
+\tCRect clientRect;
+\tGetClientRect(&clientRect);
+\tSetHoverItem(clientRect.PtInRect(point) ? HitTest(point) : -1);
+}
